{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension (basic example)",
			"type": "extensionHost",
			"request": "launch",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/examples/basic"],
			"outFiles": ["${workspaceFolder}/out/**/*.js"],
			"preLaunchTask": "${defaultBuildTask}"
		},
		{
			"name": "Run Extension (legacy example)",
			"type": "extensionHost",
			"request": "launch",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/examples/legacy"],
			"outFiles": ["${workspaceFolder}/out/**/*.js"],
			"preLaunchTask": "${defaultBuildTask}"
		},
		{
			"name": "Run Extension (wsh-iot)",
			"type": "extensionHost",
			"request": "launch",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/../wsh-iot"],
			"outFiles": ["${workspaceFolder}/out/**/*.js"],
			"preLaunchTask": "${defaultBuildTask}"
		}
	]
}
